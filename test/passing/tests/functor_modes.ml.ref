(* modes on functor parameters *)

module F (M : S @ portable) = struct end

module F (M : S @ portable) (M' : S) = struct end

module F (M : S) (M' : S @ portable) @ portable = struct end

module F (M : S @ portable) (M' : S @ portable) : T @ portable = struct
  let g = M.f
end

module F (M : S @ contended portable) (_ : S @ local) () = struct end

module F (M : S @ portable) = M

module F (M : sig
  val f : unit -> unit
end @ portable) =
struct end

module F (X : sig
  val x : int
end @ portable) (Y : sig
  val y : int
end) =
struct end

module F
    (X : sig
      val x : int
    end @ portable)
    (Y : S) =
struct end

(* long syntax *)

module F : functor (_ : S @ portable) -> T @ portable =
functor
  (M : S @ portable)
  ->
  struct
    let g = M.f
  end

module F : functor (M : S @ stateful) ->
  (functor () -> sig end) @ stateless =
functor (M : S @ stateful) () -> struct end

module F (M : S @ read_write) : (functor () -> sig end) @ stateless =
functor () -> struct end

module F1 (M1 : S @ stateful) : (functor () -> sig end) @ stateless =
functor () -> struct end

module M =
  (functor
    (M : sig
       val f : unit -> unit
     end @ portable)
    ->
    struct end)
    (X)

(* module types *)

module type FT = functor (_ : S @ portable) -> T @ portable

module type FT = functor (_ : S @ portable) (_ : S) -> T @ portable

module type FT = functor (M : S @ portable) -> T @ portable

module type FT = functor (M : S @ portable) (N : S @ portable) ->
  T @ portable

module type FT = functor (M : S @ portable) (N : S @ portable) ->
  T @ portable

module type FT = functor (M : S @ portable) ->
  (functor (N : S @ portable) -> T) @ portable

module type FT = functor (M : S) -> sig
  val f : unit -> unit
end @ portable

module type FT = functor
  (M : sig
     val f : unit -> unit
   end @ portable)
  -> T

module type FT = functor (_ : (functor () () -> sig end) @ local) -> sig end

module type FT = functor (_ : (S with type t = int) @ portable) ->
  (S with type t = int) @ portable

module type FT = functor (_ : (module type of M) @ portable) ->
  (S with M) @ portable

module type FT = functor (_ : (functor (_ : S) -> S) @ portable) ->
  (functor (_ : S) -> S) @ portable

module type Portable_Portable = sig
  module F : functor (M : S @ portable) -> T @ portable
end

module type SigWithModalFunctor2 = sig
  module (F @@ portable) : functor (_ : S @ portable) -> S @ portable
end

(* module types that must be parenthesized to be followed by modes *)

module F (K : (functor () () -> sig end) @ local) = struct
  module (K' @ global) = K ()
end

module F (M : functor (_ : S @ shareable) -> S) : functor (_ : S) -> S = M

module F
    (M : functor (_ : functor (_ : S @ portable) -> S) -> S) : functor
  (_ : functor (_ : S) -> S)
  -> S =
  M

module F (M : (functor (_ : S) -> S) @ portable) :
  (functor (_ : S) -> S) @ portable =
  M

module F (M : (S with type t = int) @ portable) = struct end

module F (M : (module type of N) @ portable) = struct end

module F (M : (S with N) @ portable) = struct end

module M : (functor (_ : S) -> S) @ portable = F

module M = (F : (functor (_ : S) -> S) @ portable) (X)

module M = F ((M : S @ m))

module M = F ((
  M :
    sig
      type t
    end @ m ))

(* let module *)

let () =
  let module F (M : S @ portable) = struct end in
  ()

let () =
  let module F (M : S @ portable) (N : S) : T @ portable = struct end in
  ()

let () =
  let module (F @ stateful) () @ stateless = functor () -> struct end in
  let module (M' @ stateless) = F () in
  ()

let () =
  let module F (M : (functor (_ : S) -> S) @ portable) = struct end in
  ()

(* long lines *)

module Mmmmmmmmmmmmmmmmmmmmmmmmmmmm
    (X : Sssssssssssssssssssssssssssss @ portable) :
  Sssssssssssssssssssssssssssssssssssssss @ portable =
  M

module type FT = functor (_ : Ssssssssssssssssssssssssssssssssssssssssss) ->
  Tttttttttttttttt @ portable

module type FT = functor (_ : Ssssssssssssssssssssssssssssssssssssssssss) ->
  (Tttttttttttttttt with type t = int) @ portable

module type FT = functor
  (_ : Ssssssssssssssssssssssssssssssssssssssssss @ portable)
  -> Tttttttttttttttt @ portable

module type FT = functor
  (Xxxxxxxxxxxxxxxxx : Ssssssssssssssssssssssssssssssssssssssssss
                       @ contended portable)
  -> Tttttttttttttttt @ portable

